# Copie para backend/.env e ajuste o que precisar.

# Banco de dados. Sem esta variável o backend usa SQLite em backend/data/ofi.db.
# DATABASE_URL=postgresql+psycopg://ofi:ofi_local@localhost:5432/ofi

# Dataset sintético (gerado automaticamente na primeira inicialização com banco vazio)
SEED_CUSTOMERS=5000
SEED_RANDOM_STATE=42
# REFERENCE_DATE=2026-09-24   # padrão: hoje (histórico = 12 meses fechados anteriores)

# IA generativa (opcional). Sem chave, os textos são escritos por um redator
# determinístico a partir dos mesmos fatos calculados pelos motores.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=low

# Origens autorizadas a chamar a API diretamente (o frontend usa proxy do Next.js)
# CORS_ORIGINS=["http://localhost:3000"]
